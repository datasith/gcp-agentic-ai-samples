<mxfile host="app.diagrams.net" modified="2026-11-04T04:30:00.000Z" agent="gcp-agentic-ai-samples" version="24.7.17" type="device">
  <diagram id="cross-platform-3p-a2a-interop" name="3P to GCP Agent Runtime Architecture">
    <mxGraphModel dx="1440" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_box" value="Cross-Platform 3P Agent &amp;lt;-&amp;gt; GCP Vertex AI Agent Runtime Interoperability (A2A + WIF + Agent Registry + Agent Gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A73E8;strokeColor=#1557B0;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="48" as="geometry"/></mxCell>
        <mxCell id="zone_3p" value="External 3P SaaS / Agent Platform (e.g., LMS / Hugging Face Spaces / Partner Cloud)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#5F6368;fontColor=#202124;fontStyle=1;fontSize=13;startSize=32;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="320" height="690" as="geometry"/></mxCell>
        <mxCell id="node_3p_agent" value="&lt;b&gt;External 3P A2A Agent&lt;/b&gt;&lt;br&gt;(FastAPI / SaaS Runtime)&lt;br&gt;&lt;br&gt;• GET /.well-known/agent-card.json&lt;br&gt;• POST /a2a (JSON-RPC 2.0 v0.3.0)&lt;br&gt;• Returns Task + contextId + Artifacts&lt;br&gt;• POST /delegate-to-gcp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_3p"><mxGeometry x="20" y="55" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="node_3p_idp" value="&lt;b&gt;3P OIDC Identity Provider (IdP)&lt;/b&gt;&lt;br&gt;(Built-in RS256 Signer or Institutional IdP)&lt;br&gt;&lt;br&gt;• GET /.well-known/openid-configuration&lt;br&gt;• GET /.well-known/jwks.json&lt;br&gt;• Signs JWT (sub: agent:external-3p-lms-agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#137333;fontColor=#0D652D;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_3p"><mxGeometry x="20" y="260" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="node_3p_tools" value="&lt;b&gt;3P Domain Skills &amp;amp; Data&lt;/b&gt;&lt;br&gt;• course_syllabus_lookup (CS-401, AI-302)&lt;br&gt;• student_support_ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;fontColor=#3C4043;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_3p"><mxGeometry x="20" y="445" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="zone_inbound" value="Direction 1 (Inbound: 3P -&amp;gt; GCP): Keyless WIF Auth &amp;amp; Ingress Governance" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#137333;fontColor=#0D652D;fontStyle=1;fontSize=13;startSize=32;rounded=1;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="540" height="310" as="geometry"/></mxCell>
        <mxCell id="node_wif_sts" value="&lt;b&gt;[1] IAM Workload Identity Federation (WIF) + STS&lt;/b&gt;&lt;br&gt;• Pool: external-3p-agent-pool / Provider: external-3p-oidc-provider&lt;br&gt;• RFC 8693 Token Exchange at sts.googleapis.com/v1/token&lt;br&gt;• Maps assertion.sub -&amp;gt; principal://iam.googleapis.com/.../subject/agent:external-3p-lms-agent&lt;br&gt;• Grants roles/aiplatform.user (Zero Static Service Account Keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#137333;fontColor=#202124;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="zone_inbound"><mxGeometry x="20" y="45" width="500" height="115" as="geometry"/></mxCell>
        <mxCell id="node_ingress_gw" value="&lt;b&gt;[2] Agent Gateway (CLIENT_TO_AGENT Ingress Mode) + Model Armor&lt;/b&gt;&lt;br&gt;• Governs synchronous query / streamQuery &amp;amp; A2A (/v1/card, /v1/message:send)&lt;br&gt;• Model Armor Template: Prompt Injection, Jailbreak &amp;amp; PII/FERPA DLP screening&lt;br&gt;• Note: Agent Runtime /v1/card requires Bearer token (not anonymous)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="zone_inbound"><mxGeometry x="20" y="175" width="500" height="115" as="geometry"/></mxCell>
        <mxCell id="zone_outbound" value="Direction 2 (Outbound: GCP -&amp;gt; 3P): Agent Registry, Auth Manager &amp;amp; Egress Governance" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;fontColor=#681DA8;fontStyle=1;fontSize=13;startSize=32;rounded=1;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="540" height="360" as="geometry"/></mxCell>
        <mxCell id="node_registry" value="&lt;b&gt;[A] Agent Registry (Regional: us-central1)&lt;/b&gt;&lt;br&gt;• google_agent_registry_service (type = A2A_AGENT_CARD, top-level interfaces omitted)&lt;br&gt;• Auto-ingests into agents/agentregistry-{uuid} + indexes ReasoningEngine&lt;br&gt;• Resolved once at container startup via registry.list_agents() + get_remote_a2a_agent()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontColor=#202124;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="zone_outbound"><mxGeometry x="20" y="45" width="500" height="95" as="geometry"/></mxCell>
        <mxCell id="node_auth_mgr" value="&lt;b&gt;[B] Agent Identity Auth Manager + Registry Binding&lt;/b&gt;&lt;br&gt;• google_agent_identity_auth_provider (stores 3P 2LO/3LO OAuth or Bearer API Token)&lt;br&gt;• google_agent_registry_binding links Source ReasoningEngine URN -&amp;gt; Target 3P Service URN&lt;br&gt;• ADK attaches credentials via CredentialManager.register_auth_provider(GcpAuthProvider())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#137333;fontColor=#202124;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="zone_outbound"><mxGeometry x="20" y="150" width="500" height="95" as="geometry"/></mxCell>
        <mxCell id="node_egress_gw" value="&lt;b&gt;[C] Agent Gateway (AGENT_TO_ANYWHERE Egress) + IAM UAP + AuthzPolicy&lt;/b&gt;&lt;br&gt;• Default-deny outbound proxy via IAP v2 (iap.googleapis.com/resources.egressViaIAP)&lt;br&gt;• Scoped to destination.agent_registry.service.name (requires disableAccessPolicyBindings=false)&lt;br&gt;• AuthzPolicy allowlists *.googleapis.com + *.mtls.googleapis.com to prevent HTTP 498 lockout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="zone_outbound"><mxGeometry x="20" y="255" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="zone_gcp" value="Google Cloud Project: Vertex AI Agent Runtime (us-central1)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#174EA6;fontStyle=1;fontSize=13;startSize=32;rounded=1;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="380" height="690" as="geometry"/></mxCell>
        <mxCell id="node_re" value="&lt;b&gt;ReasoningEngine (StreamingAdkApp)&lt;/b&gt;&lt;br&gt;academic-interop-orchestrator&lt;br&gt;&lt;br&gt;• Attested SPIFFE Agent Identity:&lt;br&gt;  principal://agents.global.org-ORG.system.id.goog/...&lt;br&gt;• Startup Hook: StreamingAdkApp.set_up()&lt;br&gt;• Pinned: google-adk[a2a,agent-identity,mcp]==2.13.0&lt;br&gt;• Callback: _strip_part_metadata_for_vertex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#202124;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_gcp"><mxGeometry x="20" y="50" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="node_gemini" value="&lt;b&gt;Vertex AI Global Model Endpoint&lt;/b&gt;&lt;br&gt;• Model: gemini-3.8-flash&lt;br&gt;• GOOGLE_CLOUD_LOCATION = &quot;global&quot;&lt;br&gt;• AGENT_REGISTRY_LOCATION = &quot;us-central1&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#174EA6;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_gcp"><mxGeometry x="20" y="265" width="340" height="115" as="geometry"/></mxCell>
        <mxCell id="node_local_tool" value="&lt;b&gt;Internal GCP Tooling&lt;/b&gt;&lt;br&gt;• get_campus_policy(topic)&lt;br&gt;  (late_submission, ferpa, ai_usage)&lt;br&gt;• VertexAiSessionService &amp;amp; MemoryBank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;fontColor=#202124;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_gcp"><mxGeometry x="20" y="405" width="340" height="115" as="geometry"/></mxCell>
        <mxCell id="node_remote_a2a" value="&lt;b&gt;ADK RemoteA2aAgent Sub-Agent&lt;/b&gt;&lt;br&gt;• Name: external_3p_lms_agent&lt;br&gt;• Single-parent rule (.clone() if shared)&lt;br&gt;• httpx Limits(max_keepalive_connections=0)&lt;br&gt;  to prevent multi-turn Event loop closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;fontColor=#202124;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="zone_gcp"><mxGeometry x="20" y="545" width="340" height="125" as="geometry"/></mxCell>
        <mxCell id="edge_in_1" value="1. OIDC JWT (RS256)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#137333;strokeWidth=2;fontColor=#0D652D;fontStyle=1;" edge="1" parent="1" source="node_3p_idp" target="node_wif_sts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_in_2" value="2. Federated Bearer Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B06000;strokeWidth=2;fontColor=#B06000;fontStyle=1;" edge="1" parent="1" source="node_3p_agent" target="node_ingress_gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_in_3" value="3. Screened A2A / streamQuery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A73E8;strokeWidth=2;fontColor=#174EA6;fontStyle=1;" edge="1" parent="1" source="node_ingress_gw" target="node_re"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_out_1" value="A. Resolve Card &amp; URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9334E6;strokeWidth=2;fontColor=#681DA8;fontStyle=1;" edge="1" parent="1" source="node_remote_a2a" target="node_registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_out_2" value="B. Fetch Bound Secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#137333;strokeWidth=2;fontColor=#0D652D;fontStyle=1;" edge="1" parent="1" source="node_remote_a2a" target="node_auth_mgr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_out_3" value="C. Governed Egress (IAP UAP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B06000;strokeWidth=2;fontColor=#B06000;fontStyle=1;" edge="1" parent="1" source="node_remote_a2a" target="node_egress_gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_out_4" value="D. POST /a2a (Bearer Token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9334E6;strokeWidth=2;fontColor=#681DA8;fontStyle=1;" edge="1" parent="1" source="node_egress_gw" target="node_3p_agent"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
