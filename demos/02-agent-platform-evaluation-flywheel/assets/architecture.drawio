        <mxCell id="z1_agent" value="finops_governance_agent (ADK 2.13)&#xa;• Model: gemini-3.8-flash (global endpoint)&#xa;• Profiles: v1_baseline vs. v2_optimized&#xa;• Deployed on ReasoningEngine (us-central1)&#xa;• Dedicated SA: adk-eval-runtime-sa" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;" vertex="1" parent="zone1">
