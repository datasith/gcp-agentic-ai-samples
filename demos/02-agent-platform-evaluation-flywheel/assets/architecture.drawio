        <mxCell id="z3_custom" value="Reusable Custom Metrics in Agent Platform Metric Registry (evaluationMetrics/*)&#xa;• Custom LLMMetric: finops_policy_citation_compliance (verifies authoritative POL-* citations)&#xa;• Custom CodeExecutionMetric: finops_audit_id_format_hygiene (deterministic QTA-*/REM-* validator)" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#137333;fontColor=#202124;fontSize=11;" vertex="1" parent="zone3">
