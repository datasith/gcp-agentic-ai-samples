        <!-- Zone 1: ADK Agent Under Test -->
        <mxCell id="zone1" value="1. ADK Agent System Under Test (us-central1 + Global Gemini 3.8)" style="swimlane;startSize=36;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#174EA6;fontStyle=1;fontSize=13;rounded=1;arcSize=4;" vertex="1" parent="1">
