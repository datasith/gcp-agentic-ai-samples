        <mxCell id="z3_loss" value="Automatic Loss Cluster Analysis (Global Endpoint) &amp; Managed EvaluationRun&#xa;• global_client.evals.generate_loss_clusters() groups failures into taxonomy patterns&#xa;• client.evals.create_evaluation_run() + EvaluationExperiment persisted to GCS &amp; Cloud Console" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;" vertex="1" parent="zone3">
