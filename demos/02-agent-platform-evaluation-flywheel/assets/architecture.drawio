        </mxCell>
        <mxCell id="z1_tools" value="Deterministic Enterprise Tools&#xa;1. get_project_spend(project_code, month)&#xa;2. lookup_governance_policy(domain)&#xa;3. submit_quota_increase_request(...)&#xa;4. create_remediation_ticket(...)" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#DADCE0;fontColor=#202124;fontSize=11;" vertex="1" parent="zone1">
          <mxGeometry x="20" y="225" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="z1_otel" value="OpenTelemetry GenAI v1.39.0 Signals&#xa;• OTEL_SEMCONV_STABILITY_OPT_IN =&#xa;  gen_ai_latest_experimental&#xa;• CAPTURE_MESSAGE_CONTENT = EVENT_ONLY&#xa;• Exports spans &amp; inference events to&#xa;  Cloud Trace &amp; Cloud Logging" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;" vertex="1" parent="zone1">
