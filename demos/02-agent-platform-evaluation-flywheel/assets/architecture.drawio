        <mxCell id="z3_prebuilt" value="Predefined Single-Turn &amp; Multi-Turn RubricMetrics&#xa;• Single-Turn: FINAL_RESPONSE_QUALITY, TOOL_USE_QUALITY, HALLUCINATION, SAFETY&#xa;• Multi-Turn: MULTI_TURN_TASK_SUCCESS, MULTI_TURN_TOOL_USE_QUALITY, MULTI_TURN_TRAJECTORY_QUALITY" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#9334E6;fontColor=#202124;fontSize=11;" vertex="1" parent="zone3">
