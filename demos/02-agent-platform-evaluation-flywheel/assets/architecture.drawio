        <mxCell id="z2_sim" value="A. Synthetic Scenario Generation (Zero Hand-Written Data Needed)&#xa;• AgentInfo.load_from_agent(root_agent)&#xa;• client.evals.generate_conversation_scenarios(count, generation_instruction, environment_context)&#xa;• Produces Starting Prompts + Hidden User Simulator Conversation Plans" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#137333;fontColor=#202124;fontSize=11;" vertex="1" parent="zone2">
