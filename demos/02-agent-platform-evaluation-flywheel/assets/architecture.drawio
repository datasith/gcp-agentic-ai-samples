        <!-- Zone 2: Scenario Generation & Inference -->
        <mxCell id="zone2" value="2. Cold-Start User Simulation &amp; Trace Capture (agentplatform.Client.evals)" style="swimlane;startSize=36;fillColor=#E6F4EA;strokeColor=#137333;fontColor=#0D652D;fontStyle=1;fontSize=13;rounded=1;arcSize=4;" vertex="1" parent="1">
