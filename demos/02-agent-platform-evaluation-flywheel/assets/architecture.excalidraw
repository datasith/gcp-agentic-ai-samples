    {
      "id": "metric_registry_text",
      "type": "text",
      "x": 432,
      "y": 407,
      "width": 516,
      "height": 281,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
