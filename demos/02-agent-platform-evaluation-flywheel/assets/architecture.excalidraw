      "roundness": null,
      "seed": 2006,
      "version": 1,
      "versionNonce": 2205,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793787600000,
      "link": null,
      "locked": false,
      "text": "3. Metric Registry, Rubric Autoraters & Loss Clusters\n- Single-Turn: FINAL_RESPONSE_QUALITY, TOOL_USE_QUALITY, HALLUCINATION, SAFETY\n- Multi-Turn: MULTI_TURN_TASK_SUCCESS, MULTI_TURN_TOOL_USE_QUALITY,\n  MULTI_TURN_TRAJECTORY_QUALITY\n- Custom Registry Metrics: LLMMetric + CodeExecutionMetric\n- Global Loss Analysis: generate_loss_clusters() + create_evaluation_run()",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "metric_registry",
      "originalText": "3. Metric Registry, Rubric Autoraters & Loss Clusters\n- Single-Turn: FINAL_RESPONSE_QUALITY, TOOL_USE_QUALITY, HALLUCINATION, SAFETY\n- Multi-Turn: MULTI_TURN_TASK_SUCCESS, MULTI_TURN_TOOL_USE_QUALITY,\n  MULTI_TURN_TRAJECTORY_QUALITY\n- Custom Registry Metrics: LLMMetric + CodeExecutionMetric\n- Global Loss Analysis: generate_loss_clusters() + create_evaluation_run()",
      "lineHeight": 1.25
    },
