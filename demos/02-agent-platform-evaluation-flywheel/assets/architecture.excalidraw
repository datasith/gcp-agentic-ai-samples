    {
      "id": "adk_agent_text",
      "type": "text",
      "x": 52,
      "y": 122,
      "width": 306,
      "height": 286,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2003,
      "version": 1,
      "versionNonce": 2202,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793787600000,
      "link": null,
      "locked": false,
      "text": "1A. ADK System Under Test\n- finops_governance_agent (ADK 2.13)\n- gemini-3.8-flash (global endpoint)\n- ReasoningEngine (us-central1)\n- Profiles: v1_baseline vs v2_optimized\n- Tools: get_project_spend, lookup_governance_policy,\n  submit_quota_increase_request, create_remediation_ticket",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "adk_agent",
      "originalText": "1A. ADK System Under Test\n- finops_governance_agent (ADK 2.13)\n- gemini-3.8-flash (global endpoint)\n- ReasoningEngine (us-central1)\n- Profiles: v1_baseline vs v2_optimized\n- Tools: get_project_spend, lookup_governance_policy,\n  submit_quota_increase_request, create_remediation_ticket",
      "lineHeight": 1.25
    },
