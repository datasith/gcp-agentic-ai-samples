    {
      "id": "otel_signals_text",
      "type": "text",
      "x": 52,
      "y": 457,
      "width": 306,
      "height": 231,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2004,
      "version": 1,
      "versionNonce": 2203,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793787600000,
      "link": null,
      "locked": false,
      "text": "1B. OpenTelemetry GenAI v1.39+ & Local Eval\n- OTEL_SEMCONV_STABILITY_OPT_IN=\n  gen_ai_latest_experimental\n- CAPTURE_MESSAGE_CONTENT=EVENT_ONLY\n- Inner-loop: adk eval adk_agent\n  adk_local_smoke.test.json",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "otel_signals",
      "originalText": "1B. OpenTelemetry GenAI v1.39+ & Local Eval\n- OTEL_SEMCONV_STABILITY_OPT_IN=\n  gen_ai_latest_experimental\n- CAPTURE_MESSAGE_CONTENT=EVENT_ONLY\n- Inner-loop: adk eval adk_agent\n  adk_local_smoke.test.json",
      "lineHeight": 1.25
