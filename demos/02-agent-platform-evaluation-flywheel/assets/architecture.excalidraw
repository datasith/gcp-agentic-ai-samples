    {
      "id": "user_sim_text",
      "type": "text",
      "x": 432,
      "y": 122,
      "width": 516,
      "height": 236,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2005,
      "version": 1,
      "versionNonce": 2204,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793787600000,
      "link": null,
      "locked": false,
      "text": "2. Cold-Start User Simulation & Golden Trace Capture\n- AgentInfo.load_from_agent(root_agent)\n- client.evals.generate_conversation_scenarios(count, instruction)\n- Curated golden_eval_cases.json regression suite\n- client.evals.run_inference(user_simulator_config={max_turn: 4})",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "user_sim",
      "originalText": "2. Cold-Start User Simulation & Golden Trace Capture\n- AgentInfo.load_from_agent(root_agent)\n- client.evals.generate_conversation_scenarios(count, instruction)\n- Curated golden_eval_cases.json regression suite\n- client.evals.run_inference(user_simulator_config={max_turn: 4})",
      "lineHeight": 1.25
    },
